# 复制为根目录 .env 后按部署环境修改；真实令牌和密钥不要提交到 Git。
# 本机演示：1 且管理令牌留空时，部分管理接口免令牌。
# 团队部署：改为 0，并设置下面的管理令牌与独立 Hook 密钥。
AG_LOCAL_TEST=1
AG_HOOK_SECRET=agentguard-dev-secret

# 设备 / 规则 / 行为基线 / 模型 / 研判的统一管理令牌。
AG_AGENT_ADMIN_TOKEN=
# 静态扫描专用令牌；留空时回退到统一管理鉴权。
AG_STATIC_ADMIN_TOKEN=
# 关闭本地测试后，控制台评测和评测 worker 使用此令牌。
AG_EVAL_ADMIN_TOKEN=
AG_EVAL_TIMEOUT=1800

# 真实大模型优先在控制台“模型管理”配置并分配用途，无需写入此文件。
# 通用 Hook 夹具评测和固定语料测试均无需模型 API Key。

# HTTP MCP 上游显式登记；默认没有内置服务地址。
# AG_EXTRA_UPSTREAMS={"docs":"http://your-mcp-host:8000/mcp"}
AG_EXTRA_UPSTREAMS=
AG_MANAGED_MCP_SERVERS=
# 静态扫描目录需自行只读挂载，并在这里登记容器内路径。
AG_STATIC_SOURCES=
AG_STATIC_ROOTS=
# 自定义禁止访问的主机名，逗号分隔。
AG_C2_HOSTS=
